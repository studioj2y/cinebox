# ===== CINEBOX 服务端 AI 配置（在 Vercel 后台「Settings → Environment Variables」添加）=====
# 复制本文件为 .env 仅用于本地 dev-server.mjs 测试；.env 已被 .gitignore 忽略，请勿提交真实 key。

# ① 多 key 轮转（核心需求）：逗号分隔，请求会按顺序轮转，单个 key 故障/限流时自动切下一个
AGNES_API_KEYS=sk-xxx,sk-yyy,sk-zzz

# ② 多提供方接入（后期测试用）：逗号分隔启用的提供方；留空默认仅 agnes
#    可选值：agnes, openai, deepseek, moonshot（在 PROVIDER_DEFS 中可继续扩展）
AI_PROVIDERS=agnes

# ③ 各提供方的 key（与 AI_PROVIDERS 中启用的对应；未启用可不填）
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=
MOONSHOT_API_KEYS=

# ④ 可选覆盖项
AGNES_MODEL=agnes-2.5-flash
OPENAI_BASE=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_BASE=
DEEPSEEK_MODEL=deepseek-chat
MOONSHOT_BASE=
MOONSHOT_MODEL=moonshot-v1-8k

# ⑤ 可选：Vercel KV 缓存（跨实例共享，降低重复 AI 调用）
#    在 Vercel 后台创建 KV store 并 Link 本项目后，以下变量会自动注入，无需手填；
#    未配置时自动降级为内存缓存（实例内热）。key 24h 过期。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
