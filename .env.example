# ===== CINEBOX 服务端 AI 配置 =====
# 【配在哪里】两处互相独立，都要单独配：
#   · 本地开发 → 项目根新建 `.env`（`node dev-server.mjs` 启动时自动加载；
#               用的是 Node 内置 process.loadEnvFile，不需要 dotenv）
#   · 线上生产 → Vercel 后台 Settings → Environment Variables
#               ⚠️ `.env` 不会被上传到 Vercel；改完线上变量需要 Redeploy 才生效
# 本文件只是模板：复制为 `.env` 再填真实 key。`.env` 已被 .gitignore 忽略，请勿提交。
#
# 故障转移语义（重点）：
#   ① 只配 Agnes  → 只用 Agnes
#   ② 只配 Gemini → 只用 Gemini
#   ③ 两者都配    → **先用 Agnes**；Agnes 报错/超时/返回为空 → 自动降级用 Gemini 重试一遍
#   ④ 一个都没配 / 都失败 → /api/interpret 返回 502，并带上每家的具体失败原因
#   优先级由 AI_PROVIDERS 的**书写顺序**决定（靠前 = 优先）。

# ① Agnes（默认首选）。AGNES_API_KEYS 支持逗号分隔多个 key，同提供方内轮转分摊。
#    单数写法 AGNES_API_KEY 也可，两者都配时以 AGNES_API_KEYS 为准。
AGNES_API_KEYS=sk-xxx,sk-yyy
# AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
# AGNES_BASE=                      # 可选，自建/代理网关时覆盖

# ② Gemini（作为 Agnes 的兜底；只填 key 即可生效，无需改 AI_PROVIDERS）。
#    key 来源：Google AI Studio（aistudio.google.com），不是 Vertex AI。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash       # ⚠️ 必须填 Gemini 真实模型名（如 gemini-2.5-flash / gemini-2.5-pro）
# GEMINI_API_KEYS=                  # 需要多 key 轮转时用这个（逗号分隔），优先于 GEMINI_API_KEY
# GEMINI_BASE=                      # 可选，默认 https://generativelanguage.googleapis.com/v1beta/openai

# ③ 提供方启用清单：逗号分隔，**顺序即优先级**。留空默认 "agnes,gemini"。
#    可选值：agnes, gemini, openai, deepseek, moonshot（想加更多兜底层就写进来并配好 key）
AI_PROVIDERS=agnes,gemini

# ④ 其它提供方（不启用可不填）
OPENAI_API_KEYS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEYS=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MOONSHOT_API_KEYS=
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# ⑤ 超时与时间预算（一般不用改；两者必须与 vercel.json 的 maxDuration 配合）
#    AI_TIMEOUT_MS：单个提供方的最长等待，到点即换掉该提供方（默认 15000）
#    AI_BUDGET_MS ：整个请求的总时间预算，默认 26000 < vercel.json 的 maxDuration 30000
#    若把 vercel.json 的 maxDuration 调大，这里可同步调大以给降级更多时间。
# AI_TIMEOUT_MS=15000
# AI_BUDGET_MS=26000

# ⑥ 可选：Vercel KV 缓存（跨实例共享，降低重复 AI 调用）
#    在 Vercel 后台创建 KV store 并 Link 本项目后，以下变量会自动注入，无需手填；
#    未配置时自动降级为内存缓存（实例内热）。key 24h 过期。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
